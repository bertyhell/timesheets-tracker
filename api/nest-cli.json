{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "database/queries/**/*.sql",
        "outDir": "dist/src"
      },
      "database/queries/**/*.sql"
    ],
    "watchAssets": true
  }
}
