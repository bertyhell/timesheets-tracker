{
  "name": "api",
  "version": "0.1.3",
  "private": true,
  "description": "Backend service for collecting and serving data for timesheet tracker",
  "license": "MIT",
  "author": "Bert Verhelst",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev:api": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "check-types": "tsc -p ./tsconfig.json --diagnostics",
    "lint": "cd .. && npm run lint",
    "format": "cd .. && npm run format",
    "bump": "npx bump-package-versions --part=patch --strategy=highest ./package.json ../package.json ../client/package.json",
    "generate-database-types": "npx typesql compile"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.13",
    "@nestjs/core": "^11.1.13",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-express": "^11.1.13",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.2.6",
    "@paymoapp/active-window": "^2.1.4",
    "@paymoapp/real-idle": "^1.1.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^2.30.0",
    "dbus-next": "^0.10.2",
    "es-toolkit": "^1.44.0",
    "fast-average-color": "^9.5.2",
    "fast-glob": "^3.3.3",
    "lodash": "^4.17.21",
    "nest-winston": "^1.10.2",
    "nested-objects-util": "^1.1.2",
    "node-ical": "^0.25.6",
    "node-startup-manager": "^0.1.3",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "uuid": "^9.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@types/bun": "^1.3.14",
    "@types/express": "^4.17.17",
    "@types/lodash": "^4.14.202",
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "bump-package-versions": "^1.0.7",
    "open": "8.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typesql-cli": "^0.22.0"
  },
  "patchedDependencies": {
    "typesql-cli@0.22.0": "patches/typesql-cli@0.22.0.patch"
  },
  "overrides": {
    "node-gyp": "^10.0.0"
  },
  "allowScripts": {
    "@paymoapp/active-window@2.1.4": true,
    "@paymoapp/real-idle@1.1.2": true,
    "@scarf/scarf@1.4.0": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "usocket@0.3.0": true
  }
}
