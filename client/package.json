{
  "name": "vite-reactts-eslint-prettier",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:client": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "generate-api-helpers": "openapi-rq -c fetch -i http://localhost:55577/docs-yaml -o ./src/generated/api && npx tsx scripts/ignore-types-in-generated-files.ts",
    "bump": "npx bump-package-versions --part=patch --strategy=highest ./package.json ../package.json ../api/package.json"
  },
  "dependencies": {
    "@nestjs/schedule": "^6.1.1",
    "@react-spectrum/s2": "^1.3.1",
    "@tanstack/react-query": "^5.100.10",
    "@tippyjs/react": "4.2.6",
    "baseline-browser-mapping": "^2.9.19",
    "blend-promise-utils": "^1.29.0",
    "caniuse-lite": "^1.0.30001769",
    "copy-to-clipboard": "3.3.3",
    "date-fns": "2.30.0",
    "jotai": "^2.6.2",
    "lodash-es": "4.18.1",
    "react": "19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "19.2.0",
    "react-resizable-panels": "^4.11.1",
    "react-responsive-modal": "7.1.0",
    "react-router-dom": "6.20.0",
    "react-select": "5.10.2",
    "react-toastify": "^10.0.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@7nohe/openapi-react-query-codegen": "1.3.0",
    "@types/lodash-es": "4.17.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.4.15",
    "postcss": "8.5.14",
    "postcss-nesting": "^14.0.0",
    "pre-commit": "1.2.2",
    "tailwindcss": "3.3.3",
    "typescript": "^6.0.3",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^8.0.13"
  },
  "pre-commit": "lint"
}
